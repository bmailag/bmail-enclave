{
    "exe": "keystore",
    "key": "private.pem",
    "debug": false,
    "_comment": "Keystore enclave (ADR-006). Holds long-lived secrets for all consumer enclaves; sealed under MRENCLAVE so a re-signed malicious enclave with the same MRSIGNER cannot unseal. Designed to never change: its MRENCLAVE is the platform root of trust for key custody. heapSize is small because the keystore holds little plaintext at any moment (it unseals + serves on demand). productID 5 reserved for keystore.",
    "heapSize": 256,
    "productID": 5,
    "securityVersion": 1,
    "mounts": [
        {"source": "/opt/bmail/keystore-sealed", "target": "/opt/bmail/keystore-sealed", "type": "hostfs", "readOnly": false},
        {"source": "/opt/bmail/keystore-snapshots", "target": "/opt/bmail/keystore-snapshots", "type": "hostfs", "readOnly": false},
        {"source": "/opt/bmail/sealed", "target": "/opt/bmail/sealed", "type": "hostfs", "readOnly": false},
        {"source": "/etc/ssl/certs", "target": "/etc/ssl/certs", "type": "hostfs", "readOnly": true},
        {"source": "/etc/resolv.conf", "target": "/etc/resolv.conf", "type": "hostfs", "readOnly": true}
    ],
    "env": [
        {"name": "VP_ENV", "fromHost": true},
        {"name": "KEYSTORE_LISTEN", "fromHost": true},
        {"name": "KEYSTORE_HEALTH_LISTEN", "fromHost": true},
        {"name": "KEYSTORE_HOSTNAME", "fromHost": true},
        {"name": "KEYSTORE_SEALED_DIR", "fromHost": true},
        {"name": "KEYSTORE_TLS_KEY_PATH", "fromHost": true},
        {"name": "KEYSTORE_EXPECTED_CLIENT_MRSIGNER", "fromHost": true},
        {"name": "KEYSTORE_BREAK_GLASS_PUBKEY_HEX", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_LOCAL_DIR", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_ENDPOINT", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_BUCKET", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_PREFIX", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_ACCESS_KEY", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_SECRET_KEY", "fromHost": true},
        {"name": "KEYSTORE_SNAPSHOT_S3_INSECURE", "fromHost": true}
    ]
}
